{
  "mcpServers": {
    "mcp-core": {
      "command": "/usr/local/bin/mcp-server",
      "args": ["--port", "4096"],
      "healthCheck": "curl -s http://localhost:4096/health"
    },
    "filesystem": {
      "command": "/usr/local/bin/mcp-server-filesystem",
      "args": ["/Users/lorenzo/Projects/inbox-zero-google-migration"],
      "permissions": {
        "read": true,
        "write": true
      }
    },
    "git": {
      "command": "/usr/local/bin/mcp-server-git",
      "args": [
        "--repository",
        "/Users/lorenzo/Projects/inbox-zero-google-migration"
      ],
      "permissions": {
        "read": true,
        "write": true
      }
    },
    "websearch": {
      "command": "/usr/local/bin/mcp-server-websearch",
      "args": ["--rate-limit", "10/1m"]
    },
    "docker": {
      "command": "/usr/local/bin/docker-mcp-adapter",
      "args": ["--socket", "/var/run/docker.sock"]
    },
    "ci-cd": {
      "command": "/usr/local/bin/mcp-cicd",
      "args": ["--config", "/etc/mcp/cicd.yaml"]
    },
    "cloud-aws": {
      "command": "/usr/local/bin/aws-mcp-adapter",
      "args": ["--profile", "inbox-zero"]
    }
  },
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio", "--tsserver-path", "node_modules/typescript/lib"]
    },
    "dockerfile": {
      "command": "dockerfile-language-server-nodejs",
      "args": ["--stdio"]
    },
    "markdown": {
      "command": "marksman",
      "args": ["server"]
    }
  }
}
