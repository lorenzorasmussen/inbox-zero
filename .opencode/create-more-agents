    return data ? JSON.parse(data) : null;
  }

  async setCleanupProgress(
    cleanupJobId: string,
    progress: {
      current: number;
      total: number;
      status: string;
    }
  ): Promise<void> {
    const key = `cleanup:progress:${cleanupJobId}`;
    await this.redis.setex(key, this.TTL * 2, JSON.stringify(progress));
  }
