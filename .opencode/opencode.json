{
  "tools": { "glob": "false" },
  "mcpServers": {
    "context7": {
      "command": "context7-server",
      "args": []
    },
    "gh_grep": {
      "command": "context7-server",
      "args": ["--library", "gh-grep-search"]
    },
    "git": {
      "command": "context7-server",
      "args": ["--library", "git-operations"]
    },
    "websearch": {
      "command": "context7-server",
      "args": ["--library", "websearch"]
    }
  },
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"]
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"]
    },
    "json": {
      "command": "vscode-json-languageserver",
      "args": ["--stdio"]
    }
  },
  "agents": {
    "build": {
      "description": "Primary integration orchestrator for OpenCode + Spec-Kit + Copilot-CLI",
      "tools": [
        "read",
        "write",
        "edit",
        "bash",
        "grep",
        "glob",
        "list",
        "todoread",
        "todowrite",
        "webfetch"
      ],
      "mode": "primary",
      "temperature": 0.4
    },
    "plan": {
      "description": "Strategic planning and analysis without execution",
      "tools": ["read", "glob", "grep", "webfetch", "todowrite", "todoread"],
      "mode": "primary",
      "temperature": 0.15
    },
    "review": {
      "description": "Quality assurance and validation across all integrated systems",
      "tools": ["read", "glob", "grep", "webfetch", "todoread", "todowrite"],
      "mode": "primary",
      "temperature": 0.1
    },
    "debug": {
      "description": "Primary debugging specialist for systematic issue diagnosis and resolution",
      "tools": [
        "read",
        "write",
        "edit",
        "bash",
        "grep",
        "glob",
        "list",
        "patch",
        "todoread",
        "todowrite",
        "webfetch"
      ],
      "mode": "primary",
      "temperature": 0.1
    }
  }
}
