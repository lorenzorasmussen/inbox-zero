# Database Configuration
POSTGRES_USER=postgres
POSTGRES_DB=inboxzero
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6380
REDIS_HTTP_PORT=8079
UPSTASH_REDIS_TOKEN=your_redis_token_here

# Web Application Configuration
WEB_PORT=3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Database URLs (for web application)
DATABASE_URL=postgresql://postgres:password@db:5432/inboxzero?schema=public
DIRECT_URL=postgresql://postgres:password@db:5432/inboxzero?schema=public

# Redis URLs (for web application)
UPSTASH_REDIS_URL=http://serverless-redis-http:80