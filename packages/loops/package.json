{
	"name": "@inboxzero/loops",
	"version": "0.1.0",
	"description": "Loops integration wrapper for InboxZero",
	"main": "dist/index.js",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
