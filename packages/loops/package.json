		"email",
		"marketing",
		"automation",
		"inboxzero"
	],
	"author": "InboxZero Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/inboxzero/inbox-zero-google-migration.git",
		"directory": "packages/loops"
	},
	"bugs": {
		"url": "https://github.com/inboxzero/inbox-zero-google-migration/issues"
	},
	"homepage": "https://github.com/inboxzero/inbox-zero-google-migration/tree/main/packages/loops#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"loops": "^6.0.1"
	},
	"devDependencies": {
		"@types/node": "24.9.1",
		"tsconfig": "workspace:*",
