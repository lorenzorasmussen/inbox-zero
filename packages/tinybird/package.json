{
	"name": "@inboxzero/tinybird",
	"version": "0.1.0",
	"description": "Tinybird client wrapper for InboxZero analytics",
	"main": "dist/index.js",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"test": "vitest",
		"test:ci": "vitest run",
		"test:coverage": "vitest run --coverage",
		"prepublish": "pnpm run build",
		"type-check": "tsc --noEmit"
	},
	"keywords": [
		"tinybird",
		"analytics",
		"data",
		"events",
		"inboxzero"
	],
	"author": "InboxZero Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/inboxzero/inbox-zero-google-migration.git",
		"directory": "packages/tinybird"
	},
	"bugs": {
		"url": "https://github.com/inboxzero/inbox-zero-google-migration/issues"
	},
	"homepage": "https://github.com/inboxzero/inbox-zero-google-migration/tree/main/packages/tinybird#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@chronark/zod-bird": "0.3.10",
		"p-retry": "^7.1.0",
		"zod": "3.25.46"
	},
	"devDependencies": {
		"@types/node": "24.9.1",
		"tsconfig": "workspace:*",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	}
}
