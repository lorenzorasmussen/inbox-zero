async function loadEmails(
  { emailAccountId, emailProvider, logger },
  { loadBefore }: { loadBefore: boolean }
) {
  // Determine the newest locally‑saved message
  const newestEmailSaved = await prisma.emailMessage.findFirst({
    where: { emailAccountId },
    orderBy: { date: 'desc' },
  });
  const after = newestEmailSaved?.date;   // start point for “newer” fetches

  // -----  FETCH MESSAGES AFTER the newest saved one  -----
  let pages = 0;
  let nextPageToken: string | undefined;
  while (pages < MAX_PAGES) {
    const res = await saveBatch({
      emailAccountId,
      emailProvider,
      logger,
      nextPageToken,
      after,
      before: undefined,
    });
    nextPageToken = res.data.nextPageToken ?? undefined;
    if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
    pages++;
    if (!nextPageToken) break;
  }

  // -----  OPTIONAL: FETCH MESSAGES BEFORE the oldest saved one  -----
  if (!loadBefore || !newestEmailSaved) return { pages };

  const oldestEmailSaved = await prisma.emailMessage.findFirst({
    where: { emailAccountId },
    orderBy: { date: 'asc' },
  });
  const before = oldestEmailSaved?.date;
  nextPageToken = undefined;
  while (pages < MAX_PAGES) {
    const res = await saveBatch({
      emailAccountId,
      emailProvider,
      logger,
      nextPageToken,
      before,
      after: undefined,
    });
    nextPageToken = res.data.nextPageToken ?? undefined;
    if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
    pages++;
    if (!nextPageToken) break;
  }

  return { pages };
}
