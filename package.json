{
  "name": "inbox-zero",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=./apps/web",
    "dev": "turbo dev --filter=./apps/web",
    "test": "turbo run test --filter=./apps/web",
    "lint": "turbo lint",
    "prepare": "husky install",
    "ncu": "ncu -u -ws",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "install-mcp": "./scripts/install-mcp-dependencies.sh",
    "mcp:start": "concurrently \"context7-server --port 4096\" \"docker-mcp-adapter\" \"aws-mcp-adapter\"",
    "mcp:health": "curl -s http://localhost:4096/health || echo 'MCP server not running'",
    "mcp:verify": "context7-server --version && docker-mcp-adapter --health-check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@turbo/gen": "2.5.8",
    "concurrently": "^8.2.2",
    "dockerfile-language-server-nodejs": "^1.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.5",
    "marksman": "^2025.1",
    "prettier": "3.6.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "2.6.1",
    "typescript-language-server": "^3.4.0",
    "ultracite": "5.3.3"
  },
  "packageManager": "pnpm@10.22.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4"
    },
    "patchedDependencies": {
      "better-auth@1.3.28": "patches/better-auth@1.3.28.patch"
    }
  }
}
