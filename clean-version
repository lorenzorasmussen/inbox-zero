    });
    nextPageToken = res.data.nextPageToken;
    if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
    pages++;
    if (!nextPageToken) break;
  }

  // ━━━ BACKWARD SYNC: Fetch older messages (optional) ━━━
  if (loadBefore && newestEmailSaved) {
    const oldestEmailSaved = await prisma.emailMessage.findFirst({
      where: { emailAccountId },
      orderBy: { date: 'asc' }
    });
    const before = oldestEmailSaved?.date;
    nextPageToken = undefined;

    while (pages < MAX_PAGES) {
      const res = await saveBatch({
        emailAccountId, emailProvider, logger,
        nextPageToken, before, after: undefined
      });
      nextPageToken = res.data.nextPageToken;
      if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
      pages++;
      if (!nextPageToken) break;
    }
  }

  return { pages };
}

**Strategy:**
- First loop: sync newer messages (`after` timestamp)
- Second loop: backfill older messages (`before` timestamp)
- Stop conditions: no more pages OR page < PAGE_SIZE OR MAX_PAGES hit

