### 3. Batch Processor

**Function**: `saveBatch()` (fetch → transform → persist)

async function saveBatch({ emailAccountId, emailProvider, logger, nextPageToken, before, after }) {
  // 1️⃣ Fetch page metadata
  const res = await emailProvider.getMessagesWithPagination({
    maxResults: PAGE_SIZE,
    pageToken: nextPageToken,
    before, after
  });

  // 2️⃣ Resolve full payloads (batch request)
  const messages = await emailProvider.getMessagesBatch(
    res.messages?.map(m => m.id).filter(isDefined) || []
  );

  // 3️⃣ Transform to DB schema
  const emailsToSave = messages.map(m => {
    const unsubscribeLink = findUnsubscribeLink(m.textHtml) || m.headers['list-unsubscribe'];
    const date = internalDateToDate(m.internalDate);

    if (!date) {
      logger.error('No date for email', { messageId: m.id });
      return;
    }

    return {
      threadId: m.threadId,
      messageId: m.id,
      from: extractEmailAddress(m.headers.from),
      fromName: extractNameFromEmail(m.headers.from),
      fromDomain: extractDomainFromEmail(m.headers.from),
      to: m.headers.to ? extractEmailAddress(m.headers.to) : 'Missing',
      date,
      unsubscribeLink,
      read: !m.labelIds?.includes('UNREAD'),
      sent: !!m.labelIds?.includes('SENT'),
      draft: !!m.labelIds?.includes('DRAFT'),
      inbox: !!m.labelIds?.includes('INBOX'),
      emailAccountId
    };
  }).filter(isDefined);

  // 4️⃣ Bulk persist with deduplication
  await prisma.emailMessage.createMany({
    data: emailsToSave,
    skipDuplicates: true  // Unique: (emailAccountId, threadId, messageId)
  });

  return { data: { messages: res.messages, nextPageToken: res.nextPageToken } };
}

**Key Operations:**
1. **Metadata fetch**: `getMessagesWithPagination` (IDs + labels)
2. **Payload fetch**: `getMessagesBatch` (full RFC822)
3. **Transform**: Extract sender/recipient/flags/unsubscribe
4. **Persist**: Idempotent bulk insert via Prisma

