## 🔍 Deep Dive: Core Components

### 1. Entry Point: Server Action

**File**: `apps/web/utils/actions/stats.ts`

export const loadEmailStatsAction = actionClient
  .metadata({ name: 'loadEmailStats' })
  .inputSchema(z.object({ loadBefore: z.boolean() }))
  .action(async ({ parsedInput, ctx }) => {
    // 1️⃣ Resolve provider (Gmail/Outlook)
    const emailAccount = await prisma.emailAccount.findUnique({
      where: { id: emailAccountId },
      select: { account: { select: { provider: true } } }
    });

    const emailProvider = await createEmailProvider({
      emailAccountId,
      provider: emailAccount.account.provider,
      logger
    });

    // 2️⃣ Execute pagination workflow
    await loadEmails({ emailAccountId, emailProvider, logger }, { loadBefore });
  });

**Constants:**
- `PAGE_SIZE = 20` (rate limit safety)
- `MAX_PAGES = 50` (runaway protection)

---

### 2. Pagination Engine

**Function**: `loadEmails()` (bidirectional sync)

async function loadEmails({ emailAccountId, emailProvider, logger }, { loadBefore }) {
  // Find newest local message
  const newestEmailSaved = await prisma.emailMessage.findFirst({
    where: { emailAccountId },
    orderBy: { date: 'desc' }
  });
  const after = newestEmailSaved?.date;

  // ━━━ FORWARD SYNC: Fetch newer messages ━━━
  let pages = 0, nextPageToken;
  while (pages < MAX_PAGES) {
    const res = await saveBatch({
      emailAccountId, emailProvider, logger,
      nextPageToken, after, before: undefined
    });
    nextPageToken = res.data.nextPageToken;
    if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
    pages++;
    if (!nextPageToken) break;
  }

  // ━━━ BACKWARD SYNC: Fetch older messages (optional) ━━━
  if (loadBefore && newestEmailSaved) {
    const oldestEmailSaved = await prisma.emailMessage.findFirst({
      where: { emailAccountId },
      orderBy: { date: 'asc' }
    });
    const before = oldestEmailSaved?.date;
    nextPageToken = undefined;

    while (pages < MAX_PAGES) {
      const res = await saveBatch({
        emailAccountId, emailProvider, logger,
        nextPageToken, before, after: undefined
      });
      nextPageToken = res.data.nextPageToken;
      if (!res.data.messages?.length || res.data.messages.length < PAGE_SIZE) break;
      pages++;
      if (!nextPageToken) break;
    }
  }

  return { pages };
}

**Strategy:**
- First loop: sync newer messages (`after` timestamp)
- Second loop: backfill older messages (`before` timestamp)
- Stop conditions: no more pages OR page < PAGE_SIZE OR MAX_PAGES hit

