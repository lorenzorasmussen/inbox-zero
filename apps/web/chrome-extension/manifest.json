{
	"manifest_version": 3,
	"name": "Inbox Zero Dev",
	"version": "1.0.0",
	"description": "Development extension for Inbox Zero",
	"permissions": ["activeTab", "storage", "scripting", "tabs"],
	"host_permissions": ["http://localhost:3001/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://localhost:3001/*"],
			"js": ["content.js"]
		}
	]
}
