import { NextRequest, NextResponse } from "next/server";
import { withAuth } from "@/utils/middleware";
import prisma from "@/utils/prisma";
import { z } from "zod";

// Types for API responses
export type GenerateApiKeyResponse = {
  success: boolean;
  key?: {
    id: string;
    keyId: string;
    keyType: "dev" | "prod" | "svc";
    name: string;
    description?: string;
    hashedKey: string;
    salt: string;
    scopes: string[];
    permissions: Record<string, boolean>;
    userId?: string;
    emailAccountId?: string;
    isActive: boolean;
    expiresAt: string;
    usageCount: number;
    rateLimitPerHour: number;
    ipRestrictions: string[];
    createdAt: string;
    updatedAt: string;
    createdBy?: string;
  };
  error?: string;
};

export type ListApiKeysResponse = {
  keys: Array<{
    id: string;
    keyId: string;
    keyType: "dev" | "prod" | "svc";
    name: string;
    description?: string;
    hashedKey: string;
    salt: string;
    scopes: string[];
    permissions: Record<string, boolean>;
    userId: string;
    emailAccountId?: string;
    isActive: boolean;
    expiresAt: string;
    usageCount: number;
    rateLimitPerHour: number;
    ipRestrictions: string[];
    createdAt: string;
    updatedAt: string;
    createdBy?: string;
    lastUsedAt?: string;
  }>;
  total: number;
  error?: string;
};

export type RotateApiKeysResponse = {
  rotated: Array<{
    id: string;
    keyId: string;
    keyType: "dev" | "prod" | "svc";
    name: string;
    description?: string;
    hashedKey: string;
    salt: string;
    scopes: string[];
    permissions: Record<string, boolean>;
    userId: string;
    emailAccountId?: string;
    isActive: boolean;
    expiresAt: string;
    usageCount: number;
    rateLimitPerHour: number;
    ipRestrictions: string[];
    createdAt: string;
    updatedAt: string;
    createdBy?: string;
  }>;
  failed: Array<{
    keyId: string;
    error: string;
  }>;
  skipped: Array<{
    keyId: string;
    reason: string;
  }>;
  summary: {
    total: number;
    rotated: number;
    failed: number;
    skipped: number;
  };
  error?: string;
};

export type RevokeApiKeysResponse = {
  revoked: Array<{
    id: string;
    keyId: string;
    revokedAt: string;
    revokedBy: string;
    reason: string;
  }>;
  failed: Array<{
    keyId: string;
    error: string;
  }>;
  summary: {
    total: number;
    revoked: number;
    failed: number;
  };
  error?: string;
};

export type GetApiKeyStatsResponse = {
  totalKeys: number;
  activeKeys: number;
  expiredKeys: number;
  usage24h: number;
  usage7d: number;
  usage30d: number;
  mostUsedKey?: {
    keyId: string;
    usage: number;
  };
  lastRotation?: string;
  error?: string;
};

export type GetApiKeyAuditTrailResponse = {
  auditTrail: Array<{
    id: string;
    apiKeyId: string;
    action: string;
    performedBy: string;
    reason?: string;
    previousValues?: Record<string, any>;
    newValues?: Record<string, any>;
    ipAddress?: string;
    timestamp: string;
  }>;
  total: number;
  error?: string;
};

// Validation schemas
const generateApiKeySchema = z.object({
  type: z.enum(['dev', 'prod', 'svc']),
  purpose: z.string().min(1, 'Purpose is required').max(200, 'Purpose cannot exceed 200 characters'),
  scopes: z.array(z.string()).max(20, 'Maximum 20 scopes allowed').optional(),
  expires: z.number().min(1, 'Expiration must be at least 1 day').max(3650, 'Expiration cannot exceed 10 years').optional(),
  ipRestrict: z.array(z.string()).max(50, 'Maximum 50 IP restrictions allowed').optional(),
  rateLimit: z.number().min(1, 'Rate limit must be at least 1 per hour').max(100000, 'Rate limit cannot exceed 100,000 per hour').optional(),
  name: z.string().max(100, 'Name cannot exceed 100 characters').optional(),
  description: z.string().max(500, 'Description cannot exceed 500 characters').optional(),
});

const rotateApiKeysSchema = z.object({
  type: z.enum(['dev', 'prod', 'svc']).optional(),
  keyId: z.string().optional(),
  gracePeriodHours: z.number().min(1).max(168).optional(),
  notify: z.boolean().optional(),
  excludeKeys: z.array(z.string()).optional(),
  force: z.boolean().optional(),
});

const revokeApiKeysSchema = z.object({
  keyId: z.string(),
  reason: z.string().min(1, 'Reason is required').max(500, 'Reason cannot exceed 500 characters'),
  force: z.boolean().optional(),
});

const listApiKeysSchema = z.object({
  type: z.enum(['dev', 'prod', 'svc']).optional(),
  status: z.enum(['active', 'expired']).optional(),
  includeUsage: z.boolean().optional(),
  format: z.enum(['table', 'json']).optional(),
  export: z.string().optional(),
});

const validateApiKeySchema = z.object({
  key: z.string().min(1, 'API key is required'),
});

// Helper functions
async function getApiKeysData({ userId }: { userId: string }) {
  const keys = await prisma.apiKey.findMany({
    where: { userId },
    select: {
      id: true,
      keyId: true,
      keyType: true,
      name: true,
      description: true,
      hashedKey: true,
      salt: true,
      scopes: true,
      permissions: true,
      userId: true,
      emailAccountId: true,
      isActive: true,
      expiresAt: true,
      usageCount: true,
      rateLimitPerHour: true,
      ipRestrictions: true,
      createdAt: true,
      updatedAt: true,
      createdBy: true,
      lastUsedAt: true,
    },
    orderBy: { createdAt: 'desc' },
  });

  const totalKeys = await prisma.apiKey.count({
    where: { userId },
  });

  return { keys, totalKeys };
}

async function getApiKeyStatsData({ userId }: { userId: string }) {
  const [
    totalKeys,
    activeKeys,
    expiredKeys,
  ] = await Promise.all([
    prisma.apiKey.count({ where: { userId, isActive: true } }),
    prisma.apiKey.count({ where: { userId, isActive: false, expiresAt: { lte: new Date() } }),,
  ]);

  const mostUsedKey = await prisma.apiKey.findFirst({
    where: { userId },
    orderBy: { usageCount: 'desc' },
    select: {
      id: true,
      keyId: true,
      usageCount: true,
    },
  });

  const lastRotation = await prisma.apiKeyRotationSchedule.findFirst({
    where: { 
      apiKey: { 
        userId: { 
          isActive: true 
        } 
      } 
    },
    orderBy: { createdAt: 'desc' },
    select: {
      createdAt: true,
    },
  });

  return {
    totalKeys,
    activeKeys,
    expiredKeys,
    mostUsedKey: mostUsedKey ? {
      keyId: mostUsedKey.keyId,
      usage: mostUsedKey.usageCount,
    } : undefined,
    lastRotation: lastRotation?.createdAt,
   };
 }

async function getApiKeyAuditTrailData({ 
  userId, 
  limit = 50,
  keyId 
}: { 
  userId?: string; 
  limit?: number; 
  keyId?: string; 
}) {
  const whereClause: { userId };
  if (keyId) {
    whereClause.apiKeyId = keyId;
  }
  if (limit) {
    whereClause.limit = limit;
  }

  const auditTrail = await prisma.apiKeyAuditTrail.findMany({
    where: whereClause,
    orderBy: { timestamp: 'desc' },
    take: limit || 50,
    select: {
      id: true,
      apiKeyId: true,
      action: true,
      performedBy: true,
      reason: true,
      previousValues: true,
      newValues: true,
      ipAddress: true,
      timestamp: true,
    },
  });

  const total = await prisma.apiKeyAuditTrail.count({
    where: whereClause,
  });

  return { auditTrail, total };
  };
}

// API route handlers
export const GET = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const result = await getApiKeysData({ userId });
    return NextResponse.json(result);
  } catch (error) {
    console.error('Error fetching API keys:', error);
    return NextResponse.json(
      { error: 'Failed to fetch API keys' },
      { status: 500 }
    );
  }
});

export const POST = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const body = await request.json();
    const validation = generateApiKeySchema.safeParse(body);

    if (!validation.success) {
      return NextResponse.json(
        { error: validation.error || 'Invalid request body' },
        { status: 400 }
      );
    }

    const { type, purpose, scopes, expires, ipRestrict, rateLimit, name, description } = validation.data;

    // Check if user has reached maximum keys
    const existingKeysCount = await prisma.apiKey.count({
      where: { userId },
    });

    if (existingKeysCount >= 10) {
      return NextResponse.json(
        { error: 'Maximum number of API keys reached (10)' },
        { status: 429 }
      );
    }

    // Generate new API key
    const generator = await import('../utils/api-keys/generator');
    const newKey = await generator.generateApiKey(type, {
      purpose,
      scopes,
      expires,
      ipRestrict,
      rateLimit,
      name,
      description,
    });

    if (!newKey.success || !newKey.key) {
      return NextResponse.json(
        { error: newKey.error || 'Failed to generate API key' },
        { status: 500 }
      );
    }

    // Save to database
    const createdKey = await prisma.apiKey.create({
      data: {
        ...newKey.key!,
        userId,
        emailAccountId: null, // Will be set when user is assigned to email account
        isActive: true,
        usageCount: 0,
        rateLimitPerHour: rateLimit || 1000,
        ipRestrictions: ipRestrict || [],
        createdAt: new Date(),
        updatedAt: new Date(),
        createdBy: userId,
      },
    });

    // Log to audit trail
    await prisma.apiKeyAuditTrail.create({
      data: {
        id: randomUUID(),
        apiKeyId: createdKey.id,
        action: 'create',
        performedBy: userId,
        reason: 'API key generated',
        newValues: { type: type, permissions: newKey.key!.permissions },
        ipAddress: request.ip,
        timestamp: new Date(),
      },
    });

    const result = await getApiKeysData({ userId });
    return NextResponse.json(result);
  } catch (error) {
    console.error('Error generating API key:', error);
    return NextResponse.json(
      { error: 'Failed to generate API key' },
      { status: 500 }
    );
  }
});

export const PUT = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const { keyId } = await request.json();
    const body = await request.json();
    const validation = rotateApiKeysSchema.safeParse(body);

    if (!validation.success) {
      return NextResponse.json(
        { error: validation.error || 'Invalid request body' },
        { status: 400 }
      );
    }

    // Rotate API key
    const rotator = await import('../utils/api-keys/rotator');
    const result = await rotator.rotateSingleKey(keyId, {
      gracePeriodHours: validation.gracePeriodHours,
      notify: validation.notify,
    });

    if (!result.success) {
      return NextResponse.json(
        { error: result.failed?.[0]?.error || 'Failed to rotate API key' },
        { status: 500 }
      );
    }

    const updatedResult = await getApiKeysData({ userId });
    return NextResponse.json(updatedResult);
  } catch (error) {
    console.error('Error rotating API key:', error);
    return NextResponse.json(
      { error: 'Failed to rotate API key' },
      { status: 500 }
    );
  }
});

export const DELETE = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const { keyId } = await request.json();
    const body = await request.json();
    const validation = revokeApiKeysSchema.safeParse(body);

    if (!validation.success) {
      return NextResponse.json(
        { error: validation.error || 'Invalid request body' },
        { status: 400 }
      );
    }

    // Revoke API key
    const rotator = await import('../utils/api-keys/rotator');
    const result = await rotator.revokeKey(keyId, {
      reason: validation.reason,
      force: validation.force,
    });

    if (!result.success) {
      return NextResponse.json(
        { error: result.failed?.[0]?.error || 'Failed to revoke API key' },
        { status: 500 }
      );
    }

    const updatedResult = await getApiKeysData({ userId });
    return NextResponse.json(updatedResult);
  } catch (error) {
    console.error('Error revoking API key:', error);
    return NextResponse.json(
      { error: 'Failed to revoke API key' },
      { status: 500 }
    );
  }
});

// Batch operations
export const POST_BATCH = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const body = await request.json();
    const validation = rotateApiKeysSchema.safeParse(body);

    if (!validation.success) {
      return NextResponse.json(
        { error: validation.error || 'Invalid request body' },
        { status: 400 }
      );
    }

    const { type, excludeKeys, gracePeriodHours, notify, force } = validation.data;

    // Rotate multiple keys
    const rotator = await import('../utils/api-keys/rotator');
    const result = await rotator.rotateKeys({
      type,
      gracePeriodHours,
      notify,
      excludeKeys,
      force,
    });

    if (!result.success) {
      return NextResponse.json(
        { error: result.failed?.[0]?.error || 'Failed to rotate API keys' },
        { status: 500 }
      );
    }

    const updatedResult = await getApiKeysData({ userId });
    return NextResponse.json(updatedResult);
  } catch (error) {
    console.error('Error rotating API keys:', error);
    return NextResponse.json(
      { error: 'Failed to rotate API keys' },
      { status: 500 }
    );
  }
});

// Stats and audit endpoints
export const GET_STATS = withAuth(async (request) => {
  const { userId } = request.auth;

  try {
    const result = await getApiKeyStatsData({ userId });
    return NextResponse.json(result);
  } catch (error) {
    console.error('Error fetching API key stats:', error);
    return NextResponse.json(
      { error: 'Failed to fetch API key statistics' },
      { status: 500 }
    );
  }
});

export const GET_AUDIT_TRAIL = withAuth(async (request) => {
  const { userId } = request.auth;
  const url = new URL(request.url);
  const limit = parseInt(url.searchParams.get('limit') || '50');
  const keyId = url.searchParams.get('keyId');

  try {
    const result = await getApiKeyAuditTrailData({ 
      userId, 
      limit,
      keyId 
    });
    return NextResponse.json(result);
  } catch (error) {
    console.error('Error fetching API key audit trail:', error);
    return NextResponse.json(
      { error: 'Failed to fetch API key audit trail' },
      { status: 500 }
    );
  }
});

// Validation endpoint
export const POST_VALIDATE = withAuth(async (request) => {
  try {
    const { key } = await request.json();
    const validator = await import('../utils/api-keys/validator');
    const result = await validator.validateApiKey(key.key);

    return NextResponse.json(result);
  } catch (error) {
    console.error('Error validating API key:', error);
    return NextResponse.json(
      { error: 'Failed to validate API key' },
      { status: 500 }
    );
  }
});