#!/usr/bin/env sh
set -e

# Git Agent Pre-commit Hook
# Ensures all Git operations meet OpenCode constitutional standards

echo "🔄 Git Agent Pre-commit Checks"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)
if [ -z "$STAGED_FILES" ]; then
    echo "⚠️  No files staged for commit"
    exit 0
fi

# Check for OpenCode agent files
if echo "$STAGED_FILES" | grep -q "\.opencode/"; then
    echo "📝 OpenCode Configuration Changes Detected"
    
    # Validate OpenCode agent configurations
    for file in $(echo "$STAGED_FILES" | grep "\.opencode/" | tr '\n' ' '); do
        if [ -f "$file" ]; then
            echo "🔍 Validating OpenCode agent file: $file"
            
            # Check JSON syntax for agent configs
            if [[ "$file" == *.json ]]; then
                if ! jq empty "$file" 2>/dev/null; then
                    echo "❌ Invalid JSON in $file"
                    exit 1
                fi
            fi
            
            # Check YAML syntax for constitutional checks
            if [[ "$file" == *.yml ]] || [[ "$file" == *.yaml ]]; then
                if ! python -c "import yaml; yaml.safe_load(open('$file'))" 2>/dev/null; then
                    echo "❌ Invalid YAML in $file"
                    exit 1
                fi
            fi
        fi
    done
fi

# Check for TypeScript/React files that need quality validation
TS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx|js|jsx)$")
if [ -n "$TS_FILES" ]; then
    echo "🔍 TypeScript/React Files Quality Check"
    
    # Run Biome check on staged files
    if ! npx biome check --staged --no-errors-on-unmatched; then
        echo "❌ Biome check failed"
        exit 1
    fi
    
    echo "✅ Code quality checks passed"
fi

# Check for documentation files
DOC_FILES=$(echo "$STAGED_FILES" | grep -E "\.(md|txt)$")
if [ -n "$DOC_FILES" ]; then
    echo "📚 Documentation Quality Check"
    
    # Basic documentation validation
    for file in $(echo "$DOC_FILES" | tr '\n' ' '); do
        if [ -f "$file" ]; then
            # Check for common documentation issues
            if grep -q "TODO\|FIXME\|XXX" "$file"; then
                echo "⚠️  Documentation contains unresolved items: $file"
            fi
            
            # Check markdown syntax
            if [[ "$file" == *.md ]]; then
                if ! python -c "import markdown; markdown.markdownFromFile(open('$file'))" 2>/dev/null; then
                    echo "❌ Invalid markdown in $file"
                    exit 1
                fi
            fi
        fi
    done
    
    echo "✅ Documentation quality checks passed"
fi

# Check for package.json changes
if echo "$STAGED_FILES" | grep -q "package.json"; then
    echo "📦 Package Configuration Validation"
    
    # Validate package.json syntax
    if ! jq empty package.json 2>/dev/null; then
        echo "❌ Invalid package.json"
        exit 1
    fi
    
    # Check for security issues in dependencies
    if npm audit --audit-level moderate; then
        echo "⚠️  Security vulnerabilities found"
        # Allow commit but warn
    else
        echo "✅ Package security checks passed"
    fi
fi

# Check for large files that should be committed separately
LARGE_FILES=$(git diff --cached --stat | awk '$5 > 1024*1024 {print $9}')
if [ -n "$LARGE_FILES" ]; then
    echo "⚠️  Large files detected that should be committed separately:"
    echo "$LARGE_FILES"
    echo ""
    echo "💡 Consider breaking this into smaller commits for better reviewability"
fi

# Check for sensitive data
SENSITIVE_PATTERNS="(API_KEY|SECRET|PASSWORD|TOKEN|PRIVATE)"
for file in $STAGED_FILES; do
    if grep -qE "$SENSITIVE_PATTERNS" "$file" 2>/dev/null; then
        echo "❌ Sensitive data detected in: $file"
        echo "🚨  This should not be committed to version control"
        exit 1
    fi
done

# Run OpenCode agent specific validations
if echo "$STAGED_FILES" | grep -q "\.opencode/agent/"; then
    echo "🤖 Git Agent Configuration Validation"
    
    # Validate agent configurations
    for agent_file in $(echo "$STAGED_FILES" | grep "\.opencode/agent/" | tr '\n' ' '); do
        if [ -f "$agent_file" ]; then
            echo "🔍 Validating Git agent: $(basename "$agent_file")"
            
            # Check agent configuration schema
            case "$agent_file" in
                *.json)
                    if ! jq empty "$agent_file" 2>/dev/null; then
                        echo "❌ Invalid agent configuration in $agent_file"
                        exit 1
                    fi
                    ;;
                *.md)
                    # Check markdown format and required sections
                    if ! grep -q "description\|capabilities\|workflows" "$agent_file"; then
                        echo "❌ Incomplete agent documentation in $agent_file"
                        exit 1
                    fi
                    ;;
            esac
        fi
    done
    
    echo "✅ Git agent configurations validated"
fi

# Check constitutional compliance
if echo "$STAGED_FILES" | grep -q "constitutional_checks.yml"; then
    echo "📋 Constitutional Compliance Check"
    
    # Validate YAML syntax
    if ! python -c "import yaml; yaml.safe_load(open('constitutional_checks.yml'))" 2>/dev/null; then
        echo "❌ Invalid constitutional checks configuration"
        exit 1
    fi
    
    # Check compliance rules
    if ! grep -q "metrics\|audit_trail\|quality_standards" "constitutional_checks.yml"; then
        echo "❌ Incomplete constitutional checks configuration"
        exit 1
    fi
    
    echo "✅ Constitutional compliance validated"
fi

# Generate commit message validation
if [ -n "$1" ]; then
    COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null)
    if [ -n "$COMMIT_MSG" ]; then
        echo "📝 Commit Message: $COMMIT_MSG"
        
        # Check for conventional commit format
        if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .+"; then
            echo "⚠️  Commit message doesn't follow conventional format"
            echo "💡 Format: type(scope): description"
            echo ""
        else
            echo "✅ Commit message follows conventional format"
        fi
    fi
fi

# Check for Git agent operations that need special handling
if echo "$STAGED_FILES" | grep -q "\.opencode/command/"; then
    echo "🔧 Git Agent Command Validation"
    
    # Validate command configurations
    for cmd_file in $(echo "$STAGED_FILES" | grep "\.opencode/command/" | tr '\n' ' '); do
        if [ -f "$cmd_file" ]; then
            echo "🔍 Validating Git command: $(basename "$cmd_file")"
            
            # Check command file structure
            if ! grep -q "description\|agent\|subtask" "$cmd_file"; then
                echo "❌ Invalid command configuration in $cmd_file"
                exit 1
            fi
        fi
    done
    
    echo "✅ Git agent commands validated"
fi

echo "✅ All pre-commit checks passed"
exit 0