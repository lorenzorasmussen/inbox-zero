		"test": {
			"env": ["RUN_AI_TESTS"]
		},
		"lint": {},
		"check-enums": {},
		"dev": {
			"cache": true,
			"persistent": true
		},
		"//#format-and-lint": {},
		"//#format-and-lint:fix": {
			"cache": true
		}
